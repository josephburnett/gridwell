{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ]
  },
  "include": [
    "e2e/**/*.ts",
    "e2e-web/**/*.ts",
    "src/**/*.test.ts",
    "src/harness/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
