{
  "name": "gridwell-desktop",
  "version": "0.0.0",
  "description": "Gridwell desktop shell (Electron). Hosts the Go sidecar and native WebContentsView URL tiles.",
  "author": "Joseph Burnett <josephburnett@fastmail.com>",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "node --test --import tsx src/main/lines.test.ts src/main/viewutil.test.ts src/main/contextmenu.test.ts src/main/gesture-threshold.test.ts",
    "test:integration": "npm run build && xvfb-run -a electron dist/harness/capture-harness.js",
    "test:bridge": "npm run build && xvfb-run -a electron dist/harness/bridge-harness.js",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.11.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-playwright-helpers": "^1.7.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.josephburnett.gridwell",
    "productName": "Gridwell",
    "directories": {
      "output": "out"
    },
    "electronDownload": {
      "cache": ".cache/electron",
      "isVerifyChecksum": false
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*"
    ],
    "extraResources": [
      {
        "from": "../../gridwell",
        "to": "gridwell"
      },
      {
        "from": "../../gridwell-localdb",
        "to": "gridwell-localdb"
      },
      {
        "from": "../../gridwell-fs",
        "to": "gridwell-fs"
      },
      {
        "from": "../../gridwell-proc",
        "to": "gridwell-proc"
      },
      {
        "from": "../../gridwell-ssh",
        "to": "gridwell-ssh"
      },
      {
        "from": "../../web",
        "to": "web"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
