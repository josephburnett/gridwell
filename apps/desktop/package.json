{
  "name": "gridwell-desktop",
  "version": "0.0.0",
  "description": "Gridwell desktop shell (Electron). Hosts the Go sidecar and native WebContentsView URL tiles.",
  "author": "Joseph Burnett <josephburnett@fastmail.com>",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "node --test --import tsx 'src/**/*.test.ts' 'e2e/**/*.test.ts' 'e2e-web/**/*.test.ts'",
    "test:integration": "npm run build && xvfb-run -a electron dist/harness/capture-harness.js",
    "test:bridge": "npm run build && xvfb-run -a electron dist/harness/bridge-harness.js",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test -c playwright.web.config.ts",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-playwright-helpers": "^1.7.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.josephburnett.gridwell",
    "productName": "Gridwell",
    "directories": {
      "output": "out"
    },
    "electronDownload": {
      "cache": ".cache/electron"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*"
    ],
    "extraResources": [
      {
        "from": "../../gridwell",
        "to": "gridwell"
      },
      {
        "from": "../../gridwell-plugin-fs",
        "to": "gridwell-plugin-fs"
      },
      {
        "from": "../../gridwell-plugin-proc",
        "to": "gridwell-plugin-proc"
      },
      {
        "from": "../../gridwell-plugin-gitlab",
        "to": "gridwell-plugin-gitlab"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
