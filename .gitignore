# Every build output at the root, under any past or future name (the
# per-name list is what let renamed binaries get committed twice;
# scripts/check-tracked-binaries.sh is the gate behind this guess).
/gridwell
/gridwell-*
/web/gridwell.wasm
/web/gridwell.wasm.gz
/web/wasm_exec.js
*.db
*.db-journal
*.db-shm
*.db-wal
/coverage.out
screenshot.png
s*.png

# Stray top-level wasm output from `GOOS=js GOARCH=wasm go build ./client/wasm/`.
/wasm

# Chromium profile when the server is run from the repo root.
/chromium/
test-results/
/apps/gridwell/gridwell
/apps/gridwell-all/gridwell-all
/client/wasm/wasm
